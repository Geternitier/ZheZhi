{
  "name": "huijing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w @huijing/server",
    "dev:web": "npm run dev -w @huijing/web",
    "start": "npm run start -w @huijing/server",
    "test": "npm run test -w @huijing/server",
    "typecheck": "npm run typecheck -w @huijing/shared && npm run typecheck -w @huijing/server && npm run typecheck -w @huijing/web"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
